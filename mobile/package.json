{
  "name": "hanguk-way-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Hanguk Way — Android va iPhone ilovasi (Capacitor)",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "node scripts/build-web.mjs && npx cap sync",
    "icons": "npx capacitor-assets generate --iconBackgroundColor '#0f3d91' --splashBackgroundColor '#f6f5f1'",
    "android": "node scripts/build-web.mjs && npx cap sync android && npx cap open android",
    "ios": "node scripts/build-web.mjs && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-mlkit/text-recognition": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.2",
    "@capgo/capacitor-social-login": "^8.7.10"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
